# Copy to deploy/.env on the VPS and fill in real values.
DB_NAME=photovault
DB_USERNAME=photovault
DB_PASSWORD=change-me-strong-password

JWT_SECRET=change-me-at-least-32-chars-of-random-bytes

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=photovault-media

# Public URL that serves media (R2 public bucket or custom CDN domain)
CDN_URL=https://media.example.com

# Comma-separated list of frontend origins (Vercel/CF Pages domains)
CORS_ALLOWED_ORIGINS=https://app.example.com,https://gallery.example.com

# API hostname Caddy will TLS-terminate
API_DOMAIN=api.example.com
