apiVersion: v1
kind: Secret
metadata:
  name: photovault-secrets
  namespace: photovault
type: Opaque
stringData:
  # Database Credentials
  db.username: "REPLACE_WITH_DB_USERNAME"
  db.password: "REPLACE_WITH_DB_PASSWORD"

  # JWT Secret (base64 encoded 256-bit key)
  jwt.secret: "REPLACE_WITH_JWT_SECRET"

  # Cloudflare R2
  r2.endpoint: "https://your-account-id.r2.cloudflarestorage.com"
  r2.access.key: "REPLACE_WITH_R2_ACCESS_KEY"
  r2.secret.key: "REPLACE_WITH_R2_SECRET_KEY"

  # AWS S3
  s3.access.key: "REPLACE_WITH_S3_ACCESS_KEY"
  s3.secret.key: "REPLACE_WITH_S3_SECRET_KEY"

---
# NOTE: In production, create secrets using:
# kubectl create secret generic photovault-secrets \
#   --from-literal=db.username=<username> \
#   --from-literal=db.password=<password> \
#   --from-literal=jwt.secret=<jwt-secret> \
#   --from-literal=r2.endpoint=<r2-endpoint> \
#   --from-literal=r2.access.key=<r2-access-key> \
#   --from-literal=r2.secret.key=<r2-secret-key> \
#   --from-literal=s3.access.key=<s3-access-key> \
#   --from-literal=s3.secret.key=<s3-secret-key> \
#   --namespace photovault
